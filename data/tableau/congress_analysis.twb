      <aliases enabled='yes' />
      <column caption='Party Group' datatype='string' name='[Calculation_1136877461949612032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [party] IN (&quot;Democrat&quot;, &quot;Independent Democrat&quot;, &quot;Popular Democrat&quot;) THEN &quot;Democrat&quot;&#13;&#10;ELSEIF [party] IN (&quot;Republican&quot;, &quot;Conservative&quot;, &quot;New Progressive&quot;) THEN &quot;Republican&quot;&#13;&#10;ELSEIF [party] IN (&quot;Independent&quot;, &quot;Independence Party (Minnesota)&quot;, &quot;Libertarian&quot;) THEN &quot;Independent&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Serving Filter' datatype='boolean' name='[Calculation_1805380534560673792]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[start_date] &lt;= [Parameters].[Parameter 2]&#13;&#10;AND&#13;&#10;(ISNULL([end_date]) OR [end_date] &gt;= [Parameters].[Parameter 2])' />
      </column>
      <column caption='Exact Age Calculation' datatype='real' name='[Calculation_1805380534561693697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[birth_date],[Parameters].[Parameter 2]) / 365.25' />
      </column>
      <column caption='Average Age' datatype='real' name='[Calculation_1805380534563057666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1805380534561693697])' />
      </column>
      <column caption='Age Calculation' datatype='integer' name='[Calculation_1993687293608185859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[birth_date],[Parameters].[Parameter 1])' />
      </column>
